<header class="site-header mb-xl">
  <a class="site-header__brand text-lg weight-700" href="{{ site.url|escape('html_attr') }}">
    {% if brand_image.src %}
      <img src="{{ brand_image.src|escape('html_attr') }}" alt="{{ brand_image.alt|default(site.name)|escape('html_attr') }}">
    {% else %}
      {{ site.name|escape }}
    {% endif %}
  </a>
  {% if primary_menu %}
    <nav class="site-navigation" aria-label="Menu principale">
      <ul class="site-navigation__list flex flex-wrap gap-md m-0 p-0" role="list">
        {% for item in primary_menu.items %}
          <li class="site-navigation__item relative">
            <a href="{{ item.link|escape('html_attr') }}" class="text-sm{% if item.current %} weight-700{% endif %}"{% if item.current %} aria-current="page"{% endif %}>{{ item.title|escape }}</a>
            {% if item.children %}
              <ul class="site-navigation__submenu m-0 p-0" role="list">
                {% for child in item.children %}
                  <li><a href="{{ child.link|escape('html_attr') }}" class="text-sm">{{ child.title|escape }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}
</header>
