<section class="documentation-section gallery" aria-labelledby="{{ gallery.id }}-title" data-gsap="reveal">
  <div class="documentation-section__intro">
    <p class="text-xs">Componente</p>
    <h2 id="{{ gallery.id }}-title">Gallery</h2>
    <p>
      Gallery riutilizzabile basata su Swiper. Riceve un identificatore, immagini
      e opzioni di visualizzazione.
    </p>
    <p class="text-xs">
      <code>images: [{ src, alt }]</code> ·
      <code>slidesDesktop: {{ gallery.slidesDesktop }}</code>
    </p>
  </div>

  <div
    class="gallery__viewport swiper"
    id="{{ gallery.id }}"
    data-gallery
    data-slides-desktop="{{ gallery.slidesDesktop }}"
    aria-label="{{ gallery.label }}"
  >
    <div class="swiper-wrapper">
      {% for image in gallery.images %}
        <div class="swiper-slide">
          <img src="{{ image.src }}" alt="{{ image.alt }}" loading="lazy"/>
        </div>
      {% endfor %}
    </div>

    <button
      class="swiper-button-prev"
      type="button"
      aria-label="Immagine precedente"
    ></button>
    <button
      class="swiper-button-next"
      type="button"
      aria-label="Immagine successiva"
    ></button>
  </div>
</section>
