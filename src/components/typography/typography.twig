<section class="documentation-section typography" aria-labelledby="typography-title" data-gsap="reveal">
  <div class="documentation-section__intro">
    <h2 id="typography-title">Typography</h2>
    <p>
      La tipografia usa token fluidi per font-size e line-height.
      Le classi <code>.text-*</code> espongono l'intera scala tipografica.
    </p>
  </div>

  <div class="typography__examples">
    <div>
      <code>.text-4xl</code>
      <div class="text-4xl">Example heading</div>
    </div>

    <div>
      <code>.text-3xl</code>
      <div class="text-3xl">Example heading</div>
    </div>

    <div>
      <code>.text-2xl</code>
      <div class="text-2xl">Example heading</div>
    </div>

    <div>
      <code>.text-xl</code>
      <div class="text-xl">Example heading</div>
    </div>

    <div>
      <code>.text-lg</code>
      <div class="text-lg">Example heading</div>
    </div>

    <div>
      <code>.text-md</code>
      <div class="text-md">Example heading</div>
    </div>

    <div>
      <code>.text-sm</code>
      <div class="text-sm">Example heading</div>
    </div>

    <div>
      <code>.text-xs</code>
      <div class="text-xs">Example heading</div>
    </div>

    <div>
      <code>p</code>
      <p>Un paragrafo usa la dimensione e l’interlinea fluide predefinite.</p>
    </div>

    <div>
      <code>ul</code>
      <ul>
        <li>Elemento di lista</li>
        <li>Elemento di lista</li>
      </ul>
    </div>
  </div>

  <p class="typography__note text-xs">
    Scale:
    <code>.text-xs</code>,
    <code>.text-sm</code>,
    <code>.text-md</code>,
    <code>.text-lg</code>,
    <code>.text-xl</code>,
    <code>.text-2xl</code>,
    <code>.text-3xl</code>,
    <code>.text-4xl</code>.
  </p>
</section>