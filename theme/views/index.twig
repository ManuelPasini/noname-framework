{% extends 'base.twig' %}
{% block content %}
  {% for post in posts %}
    <article class="my-xl">
      <h1 class="text-2xl mb-md"><a href="{{ post.link|escape('html_attr') }}">{{ post.title|escape }}</a></h1>
      {{ post.content }}
    </article>
  {% else %}
    <p class="text-md">Nessun contenuto disponibile.</p>
  {% endfor %}
{% endblock %}
