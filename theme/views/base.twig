<!doctype html>
<html {{ function('get_language_attributes')|raw }}>
  <head>
    <meta charset="{{ site.charset|escape('html_attr') }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{ function('wp_head')|raw }}
  </head>
  <body class="{{ body_class|escape('html_attr') }}">
    {{ function('wp_body_open')|raw }}
    <div class="container">
      {% include 'header/header.twig' %}
    </div>
    <main id="content">{% block content %}{% endblock %}</main>
    {{ function('wp_footer')|raw }}
  </body>
</html>
