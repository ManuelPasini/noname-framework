{% extends 'base.twig' %}
{% block content %}
  {% for component in components %}
    <section class="{{ component.section_class|escape('html_attr') }}">
      {% if not component.full_bleed %}<div class="container">{% endif %}
        {% include component.template with { component: component.data } only %}
      {% if not component.full_bleed %}</div>{% endif %}
    </section>
  {% endfor %}
{% endblock %}
