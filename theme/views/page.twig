{% extends 'base.twig' %}
{% block content %}
  {% for component in components %}
    {% if component.full_bleed %}
      {% include component.template with { component: component.data } only %}
    {% else %}
      <div class="container">
        {% include component.template with { component: component.data } only %}
      </div>
    {% endif %}
  {% endfor %}
{% endblock %}
